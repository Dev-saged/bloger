"author":{"@type":"Person","name":"<data:post.author.jsonEscaped/>","url":"https://github.com/Dev-saged","sameAs":["https://x.com/saged_al","https://www.instagram.com/sajedd.0","https://www.facebook.com/saged.t","https://www.youtube.com/@sajed0"]},
"publisher":{"@type":"NewsMediaOrganization","name":"<data:blog.title.jsonEscaped/>","url":"<data:blog.homepageUrl.jsonEscaped/>"},
"contentLocation":{"@type":"Place","name":"غزة، فلسطين"}},
{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"الرئيسية","item":"<data:blog.homepageUrl.jsonEscaped/>"},
<b:if cond='data:post.labels'><b:loop index='li' values='data:post.labels' var='label'><b:if cond='data:li == 0'>{"@type":"ListItem","position":2,"name":"<data:label.name.jsonEscaped/>","item":"<data:label.url.jsonEscaped/>"},{"@type":"ListItem","position":3,"name":"<data:post.title.jsonEscaped/>"}</b:if></b:loop><b:else/>{"@type":"ListItem","position":2,"name":"<data:post.title.jsonEscaped/>"}</b:if>]}
]}</script>
          </b:if>
        </b:includable>
