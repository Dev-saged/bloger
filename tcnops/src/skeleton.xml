      <b:widget id='PopularPosts7' locked='false' title='الأكثر قراءة' type='PopularPosts' version='1' visible='true'>
        <b:widget-settings>
          <b:widget-setting name='numItemsToShow'>5</b:widget-setting>
          <b:widget-setting name='showThumbnails'>true</b:widget-setting>
          <b:widget-setting name='showSnippets'>false</b:widget-setting>
          <b:widget-setting name='timeRange'>LAST_YEAR</b:widget-setting>
        </b:widget-settings>
        <b:includable id='main'>
          <div class='card-w'>
            <div class='wh'><h2><b:if cond='data:title != &quot;&quot;'><data:title/><b:else/>الأكثر قراءة</b:if></h2></div>
            <ol class='pop'>
              <b:loop values='data:posts' var='post'>
                <li><a expr:href='data:post.href'>
                  <div class='thumb'><b:if cond='data:post.thumbnail'><img alt='' decoding='async' expr:src='resizeImage(data:post.thumbnail, 128, &quot;1:1&quot;)' height='64' loading='lazy' width='64'/></b:if></div>
                  <h3><data:post.title/></h3>
                </a></li>
              </b:loop>
            </ol>
          </div>
        </b:includable>
      </b:widget>
      <b:widget id='Label23' locked='false' title='التصنيفات' type='Label' version='1' visible='true'>
        <b:widget-settings>
          <b:widget-setting name='sorting'>ALPHA</b:widget-setting>
          <b:widget-setting name='display'>CLOUD</b:widget-setting>
          <b:widget-setting name='selectedLabelsList'/>
          <b:widget-setting name='showType'>ALL</b:widget-setting>
          <b:widget-setting name='showFreqNumbers'>true</b:widget-setting>
        </b:widget-settings>
        <b:includable id='main'>
          <div class='card-w'>
            <div class='wh'><h2><b:if cond='data:title != &quot;&quot;'><data:title/><b:else/>التصنيفات</b:if></h2></div>
            <ul class='cloud'><b:loop values='data:labels' var='label'><li><a expr:href='data:label.url'><data:label.name/><span><data:label.count/></span></a></li></b:loop></ul>
          </div>
        </b:includable>
      </b:widget>
    </b:section>
    <div data-side-fallback=''/>
    <div class='side-sticky'>
      {{AD:ads-side-sticky:مساحة إعلانية: الشريط الجانبي الثابت:HTML80:ad-side::}}
    </div>
  </aside>
</div>
{{AD:ads-footer:مساحة إعلانية: قبل التذييل:HTML81:ad-wide::}}
</div>

<footer class='ftr'>
  <div class='wrap'>
    <div class='fcols'>
      <b:section class='fcol' id='footer-1' maxwidgets='2' name='التذييل: العمود الأول' showaddelement='yes'>
        <b:widget id='HTML51' locked='false' title='TCNOPS' type='HTML' version='1' visible='true'>
          <b:widget-settings><b:widget-setting name='content'><![CDATA[{{FOOTABOUT}}]]></b:widget-setting></b:widget-settings>
          <b:includable id='main'><b:if cond='data:title != &quot;&quot;'><h3><data:title/></h3></b:if><data:content/></b:includable>
        </b:widget>
      </b:section>
      <b:section class='fcol' id='footer-2' maxwidgets='2' name='التذييل: العمود الثاني' showaddelement='yes'>
        <b:widget id='LinkList21' locked='false' title='الصفحات' type='LinkList' version='1' visible='true'>
          <b:widget-settings>
            <b:widget-setting name='sorting'>NONE</b:widget-setting>
            {{PAGELINKS}}
          </b:widget-settings>
          <b:includable id='main'><b:if cond='data:title != &quot;&quot;'><h3><data:title/></h3></b:if><ul class='flinks'><b:loop values='data:links' var='link'><li><a expr:href='data:link.target'><data:link.name/></a></li></b:loop></ul></b:includable>
        </b:widget>
      </b:section>
      <b:section class='fcol' id='footer-3' maxwidgets='2' name='التذييل: العمود الثالث' showaddelement='yes'>
        <b:widget id='LinkList22' locked='false' title='الأقسام' type='LinkList' version='1' visible='true'>
          <b:widget-settings>
            <b:widget-setting name='sorting'>NONE</b:widget-setting>
            {{SECLINKS}}
          </b:widget-settings>
          <b:includable id='main'><b:if cond='data:title != &quot;&quot;'><h3><data:title/></h3></b:if><ul class='flinks'><b:loop values='data:links' var='link'><li><a expr:href='data:link.target'><data:link.name/></a></li></b:loop></ul></b:includable>
        </b:widget>
      </b:section>
    </div>
    <div class='fbar'>
      <span>© <span class='num' id='yr'>2026</span> <b><data:blog.title/></b> · جميع الحقوق محفوظة</span>
      <span>تصميم وتطوير <a href='https://github.com/Dev-saged' rel='noopener' target='_blank'><b>ساجد العبادلة</b></a> <span class='heart' aria-hidden='true'>●</span> من غزة، فلسطين</span>
    </div>
  </div>
</footer>

<div class='anchor-ad' hidden='hidden'>
  <button aria-label='إغلاق' class='x' type='button'><svg class='ico ico-s'><use href='#i-close'/></svg></button>
  {{AD:ads-anchor:مساحة إعلانية: ثابتة أسفل الشاشة (جوال):HTML82:ad-wide::}}
</div>

<button aria-label='العودة إلى أعلى الصفحة' class='to-top' type='button'><svg class='ico'><use href='#i-up'/></svg></button>

<nav aria-label='تنقل الجوال' class='bnav' hidden='hidden'>
  <a expr:href='data:blog.homepageUrl'><svg class='ico'><use href='#i-home'/></svg>الرئيسية</a>
  <button data-sheet='menu-sheet' type='button'><svg class='ico'><use href='#i-grid'/></svg>الأقسام</button>
  <button data-search='' type='button'><svg class='ico'><use href='#i-search'/></svg>بحث</button>
  <button data-theme-toggle='' hidden='hidden' type='button'><svg class='ico ico-moon'><use href='#i-moon'/></svg><svg class='ico ico-sun'><use href='#i-sun'/></svg>الوضع</button>
  <button class='sv-btn' data-saved-open='' hidden='hidden' type='button'><svg class='ico'><use href='#i-bookmark'/></svg>المحفوظات<span class='badge num' data-saved-count='' hidden='hidden'>0</span></button>
</nav>

<dialog aria-label='القائمة' class='sheet' id='menu-sheet'><div class='grab'/><div class='in'><div class='sheet-h'><h2>القائمة</h2><button aria-label='إغلاق' class='icon-btn' data-close='' type='button'><svg class='ico'><use href='#i-close'/></svg></button></div><div data-fill=''/></div></dialog>

<dialog aria-label='المقالات المحفوظة' class='sheet' id='saved-sheet'><div class='grab'/><div class='in'><div class='sheet-h'><h2>المقالات المحفوظة</h2><button aria-label='إغلاق' class='icon-btn' data-close='' type='button'><svg class='ico'><use href='#i-close'/></svg></button></div><div data-saved-list=''/></div></dialog>
<dialog aria-label='ثبّت التطبيق' class='sheet' id='ios-sheet'><div class='grab'/><div class='in'><div class='sheet-h'><h2>ثبّت TCNOPS على شاشتك</h2><button aria-label='إغلاق' class='icon-btn' data-close='' type='button'><svg class='ico'><use href='#i-close'/></svg></button></div><div data-ios=''/></div></dialog>
<dialog aria-label='بحث' class='sdlg' id='sdlg'>
  <form class='sform' expr:action='data:blog.homepageUrl + &quot;search&quot;' method='get' role='search'>
    <svg class='ico'><use href='#i-search'/></svg>
    <input aria-label='بحث' autocomplete='off' enterkeyhint='search' name='q' placeholder='ابحث في المقالات…' type='search'/>
    <button aria-label='إغلاق' class='icon-btn' formmethod='dialog' type='submit' value='close'><svg class='ico'><use href='#i-close'/></svg></button>
  </form>
  <div aria-live='polite' class='sres'><p class='shint'>اكتب كلمتين على الأقل لبدء البحث الفوري.</p></div>
</dialog>

<script>window.TCN_SCHEMA={{SCHEMA}};window.TCN_CFG={home:"<data:blog.homepageUrl.jsonEscaped/>",url:"<data:blog.url.jsonEscaped/>",title:"<data:blog.pageName.jsonEscaped/>"};</script>
