<b:skin><![CDATA[
/*
<Group description="ألوان القالب" selector="body">
  <Variable name="brand.light" description="اللون الأساسي (الوضع الفاتح)" type="color" default="#0f7f86" value="#0f7f86"/>
  <Variable name="brand.dark" description="اللون الأساسي (الوضع الداكن)" type="color" default="#5fd4cf" value="#5fd4cf"/>
