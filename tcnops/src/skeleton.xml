<Group description="المقاسات والخط" selector="body">
  <Variable name="site.width" description="عرض الموقع" type="length" min="960px" max="1600px" default="1280px" value="1280px"/>
  <Variable name="corner.radius" description="انحناء الزوايا" type="length" min="0px" max="32px" default="22px" value="22px"/>
  <Variable name="font.base" description="حجم الخط الأساسي" type="length" min="14px" max="20px" default="16px" value="16px"/>
  <Variable name="font.article" description="حجم خط المقال" type="length" min="15px" max="24px" default="18px" value="18px"/>
</Group>
*/
:root{--brand:$(brand.light);--brand-d:$(brand.dark);--hotc:$(hot.color);--wrap:$(site.width);--rad:$(corner.radius);--fb:$(font.base);--fa:$(font.article)}
]]></b:skin>

<b:template-skin><![CDATA[
body#layout{background:#eef3f5;font-family:system-ui,'Segoe UI',Tahoma,sans-serif;direction:rtl;min-width:0;padding:0 0 30px;color:#0f2a33}
body#layout:before{content:'TCNOPS 2026  \2014  لوحة تنسيق القالب';display:block;margin:0 0 6px;padding:20px 22px;border-radius:16px;background:linear-gradient(135deg,#0f2a33,#0f7f86);color:#fff;font:700 20px system-ui,sans-serif;box-shadow:0 14px 30px -18px #0f2a33}
