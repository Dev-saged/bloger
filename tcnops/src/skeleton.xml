body#layout .fbar,body#layout .hdr-tools,body#layout .menu-btn,body#layout .bnav,body#layout .to-top,body#layout .progress,body#layout dialog,body#layout .ticker,body#layout .anchor-ad .x{display:none}
]]></b:template-skin>

